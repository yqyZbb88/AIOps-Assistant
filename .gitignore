# 环境与依赖
.env
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.pytest_tmp*/
.patch.tmp
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 配置中可能产生的本地覆盖
*.local.yaml

# 编辑器
.vscode/
.idea/

# 本机工具配置（含本机命令白名单，不入库）
.claude/settings.local.json

# 课程讲义（56 MB，仅本地参考，不入库）
参考/

# 其它
logs/
*.log

# SQLite 持久化产物（storage.db_path 默认落在 data/）
# 务必连 -wal / -shm 一起排除：`*.db` 匹配不到这两个旁文件，而它们同样含会话原文
data/
*.db
*.db-wal
*.db-shm
