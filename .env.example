# ops-agent 环境变量样例（占位无真实值）。
# 复制为 .env 后填写真实值；.env 含密钥，切勿提交版本库。

# DeepSeek（Agent 聊天 / 告警 AI 分析）——复用根目录 init.py 的模型入口
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=30
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_MAX_TOKENS=2048

# Prometheus 数据源地址（缺省 http://localhost:9090）
PROMETHEUS_URL=http://localhost:9090

# 自动处置规则（config/rules.yaml）中 SSH 远程动作的登录密码。
# SSH known_hosts 文件；留空使用系统 ~/.ssh/known_hosts。未知主机默认拒绝连接。
SSH_KNOWN_HOSTS=
# 仅当把对应规则 auto_execute 开启为 true 时才需要；值 = 目标主机 root 密码。
SSH_PASSWORD_192_168_20_128="P@ssw0rd"

# API 共享密钥 → 身份 的 JSON 映射（配合 config/settings.yaml 的 auth.enabled 使用）。
# 留空 = 没有可用密钥；此时若 auth.enabled 为 true，服务会**拒绝启动**（快速失败）。
# 形如：{"k-alice-9f3a":"alice","k-bob-71cd":"bob"}
# 请用随机值（如 python -c "import secrets;print(secrets.token_urlsafe(32))"），
# 不要用可猜的字符串——它等价于账号密码。
#
# Alertmanager 的 webhook（POST /alert）在 auth 打开后也要密钥，而且**还要求身份**：
# 只有 settings.yaml 里 auth.alert_identity 那个身份（默认 "alertmanager"）能调它，
# 其他有效密钥一律 403。**给它一条专用密钥**，别跟人共用——alertmanager.yml 常被提交进
# 运维仓库/打进镜像，泄漏面大得多。**身份名两处要一致**：这里的值 ↔ settings.yaml 的字面量。
# 完整配方（含 Alertmanager 侧怎么配、怎么验证）见 docs/auth.md。
OPS_API_TOKENS=
