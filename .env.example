# 可选部署参数。使用默认端口并在管理员页面配置模型时，无需创建 .env。
# 首次部署模板在 deploy/templates/assistant/；持久配置在 .runtime/config/。
# .env 可能包含密钥，不提交版本库；业务登录身份由初始化服务生成。

# 通用 OpenAI 兼容聊天接口。也可全部在“系统管理 → 模型配置”中设置。
# 页面配置整组优先；明确清除页面密钥后不会回退环境密钥。
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=
MODEL_TIMEOUT=30
MODEL_MAX_RETRIES=2
MODEL_MAX_TOKENS=2048
# 高级选项：按服务文档选择 max_tokens 或 max_completion_tokens。
MODEL_TOKEN_LIMIT_PARAM=max_tokens

# 可选：额外精确脱敏值，必须是 JSON 数组。
OPS_REDACTION_SECRETS=[]

# Compose 发布端口，默认仅绑定本机；修改后重新 up。
ASSISTANT_HOST_PORT=8000
GRAFANA_HOST_PORT=3000
PROMETHEUS_HOST_PORT=9090
ALERTMANAGER_HOST_PORT=9093
NODE_EXPORTER_HOST_PORT=9100
# 自定义持久目录时，全部管理命令使用同一个目录。
# AIOPS_RUNTIME_DIR=./.runtime

# SSH 通过管理员页面配置凭据，再关联已登记主机；此处不配置 SSH。
