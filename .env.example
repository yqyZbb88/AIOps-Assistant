# AIOps-Assistant 环境变量样例。
# 复制为 .env 后填写真实值；.env 含密钥，切勿提交版本库。

# DeepSeek：聊天 Agent 和告警 AI 分析使用。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=30
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_MAX_TOKENS=2048

# 可选：额外需要在日志、存储和 API 输出中精确遮蔽的非短值，必须是 JSON 数组。
# 示例：["legacy-secret-value","vendor-token-value"]
OPS_REDACTION_SECRETS=[]

# Prometheus 监控配置。
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_INSTANCE=localhost:9100
# 本地 Python 默认为 external；Compose 内由 compose.yaml 显式设为 managed。
OPS_PROMETHEUS_TARGET_MODE=external
OPS_PROMETHEUS_TARGET_FILE=
# 上一项必须与 Prometheus 中 node_exporter 的 instance 标签一致。

# SSH：用于只读诊断和 Agent 写命令。未配置时默认连接 localhost。
SSH_HOST=localhost
SSH_PORT=22
SSH_USER=ops
SSH_PASSWORD=
SSH_KEY_FILENAME=
SSH_KNOWN_HOSTS=
# 留空表示使用系统 known_hosts；不会自动信任未知主机密钥。

# API 密钥到身份的 JSON 映射，启用鉴权时必须配置。
# 示例：{"k-admin-随机值":"admin","k-am-随机值":"alertmanager"}
OPS_API_TOKENS=

# approvers_only 模式下允许审批写命令的身份。
OPS_APPROVER_IDENTITIES=["admin"]

# 可访问系统管理界面的最高权限身份；必须存在于 OPS_API_TOKENS 的 value 中。
OPS_ADMIN_IDENTITIES=["admin"]
