# AIOps-Assistant 环境变量样例。
# 复制为 .env 后按需填写；Compose 无需 .env 也可启动，身份由初始化服务独立生成。
# .env 含密钥，切勿提交版本库。

# DeepSeek：聊天 Agent 和告警 AI 分析使用。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=30
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_MAX_TOKENS=2048

# 可选：额外需要在日志、存储和 API 输出中精确遮蔽的非短值，必须是 JSON 数组。
# 示例：["legacy-secret-value","vendor-token-value"]
OPS_REDACTION_SECRETS=[]

# SSH：供已授权的诊断和写命令使用；仅填写这些值不会启用命令或授予主机权限。
SSH_HOST=localhost
SSH_PORT=22
SSH_USER=ops
SSH_PASSWORD=
SSH_KEY_FILENAME=
SSH_KNOWN_HOSTS=
# 留空表示使用系统 known_hosts；不会自动信任未知主机密钥。

# Compose 发布端口，默认仅绑定本机。改后重新 docker compose up。
ASSISTANT_HOST_PORT=8000
GRAFANA_HOST_PORT=3000
PROMETHEUS_HOST_PORT=9090
ALERTMANAGER_HOST_PORT=9093
NODE_EXPORTER_HOST_PORT=9100
# 可选自定义部署目录；修改后所有管理命令必须使用同一个值。
# AIOPS_RUNTIME_DIR=./.runtime
# Compose SSH 文件放入 .runtime/ssh/，上述 SSH_KEY_FILENAME / SSH_KNOWN_HOSTS 使用 /run/ssh/ 路径。
