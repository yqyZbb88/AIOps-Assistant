# AIOps-Assistant 环境变量样例。
# 复制为 .env 后按需填写；Compose 无需 .env 也可启动，身份由初始化服务独立生成。
# 本地 Python 使用下面的 OPS_API_TOKENS；Compose 不使用它作为登录凭据。
# .env 含密钥，切勿提交版本库。

# DeepSeek：聊天 Agent 和告警 AI 分析使用。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=30
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_MAX_TOKENS=2048

# 可选：额外需要在日志、存储和 API 输出中精确遮蔽的非短值，必须是 JSON 数组。
# 示例：["legacy-secret-value","vendor-token-value"]
OPS_REDACTION_SECRETS=[]

# Prometheus 监控配置。
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_INSTANCE=localhost:9100
# 必须与 Prometheus 中 Node Exporter 的 instance 标签一致。
# 本地 Python 默认为 external；Compose 内由 compose.yaml 显式设为 managed。
OPS_PROMETHEUS_TARGET_MODE=external
OPS_PROMETHEUS_TARGET_FILE=

# SSH：供已授权的诊断和写命令使用；仅填写这些值不会启用命令或授予主机权限。
SSH_HOST=localhost
SSH_PORT=22
SSH_USER=ops
SSH_PASSWORD=
SSH_KEY_FILENAME=
SSH_KNOWN_HOSTS=
# 留空表示使用系统 known_hosts；不会自动信任未知主机密钥。

# API 密钥到身份的 JSON 映射，启用鉴权时必须配置。
# 示例：{"k-admin-随机值":"admin","k-am-随机值":"alertmanager"}
OPS_API_TOKENS=

# approvers_only 模式下允许审批写命令的身份。
OPS_APPROVER_IDENTITIES=["admin"]

# 可访问系统管理界面的最高权限身份；必须存在于 OPS_API_TOKENS 的 value 中。
OPS_ADMIN_IDENTITIES=["admin"]

# Compose 发布端口，默认仅绑定本机。改后重新 docker compose up。
ASSISTANT_HOST_PORT=8000
GRAFANA_HOST_PORT=3000
PROMETHEUS_HOST_PORT=9090
ALERTMANAGER_HOST_PORT=9093
NODE_EXPORTER_HOST_PORT=9100
# 可选自定义部署目录；修改后所有管理命令必须使用同一个值。
# AIOPS_RUNTIME_DIR=./.runtime
# Compose SSH 文件放入 .runtime/ssh/，上述 SSH_KEY_FILENAME / SSH_KNOWN_HOSTS 使用 /run/ssh/ 路径。
